# ============================================================================
# IPTV Guru Environment Configuration
# ============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control!

# ============================================================================
# Application Settings
# ============================================================================
NODE_ENV=development
PORT=5001
DEBUG=true

# ============================================================================
# PostgreSQL Database
# ============================================================================
# For local development with Docker Compose, use these defaults
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=iptvguru
POSTGRES_USER=iptvguru
POSTGRES_PASSWORD=changeme
POSTGRES_MAX_CONNECTIONS=20

# Production PostgreSQL (AWS RDS, Google Cloud SQL, etc.)
# POSTGRES_HOST=your-rds-endpoint.region.rds.amazonaws.com
# POSTGRES_PORT=5432
# POSTGRES_DB=iptvguru_production
# POSTGRES_USER=iptvguru_prod
# POSTGRES_PASSWORD=your-secure-password-here
# POSTGRES_MAX_CONNECTIONS=50
# POSTGRES_SSL=true

# ============================================================================
# Redis Cache & Sessions
# ============================================================================
# For local development with Docker Compose
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CLUSTER_ENABLED=false

# Production Redis (AWS ElastiCache, Redis Cloud, etc.)
# REDIS_HOST=your-redis-cluster.region.cache.amazonaws.com
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
# REDIS_DB=0
# REDIS_CLUSTER_ENABLED=true
# REDIS_CLUSTER_NODES=node1:6379,node2:6379,node3:6379

# ============================================================================
# Session Management
# ============================================================================
SESSION_SECRET=your-secret-key-change-in-production
SESSION_TTL=604800  # 7 days in seconds

# ============================================================================
# JWT Authentication
# ============================================================================
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_WINDOW=900       # 15 minutes in seconds
RATE_LIMIT_MAX_REQUESTS=100 # Max requests per window
RATE_LIMIT_AUTH_MAX=10      # Max auth requests per window

# ============================================================================
# MongoDB (Legacy - used for EPG database)
# ============================================================================
# Note: Consider migrating EPG data to PostgreSQL in the future
MONGODB_URI=mongodb://localhost:27017/iptvguru

# ============================================================================
# CORS Settings
# ============================================================================
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ============================================================================
# File Upload Settings
# ============================================================================
MAX_FILE_SIZE=104857600  # 100MB in bytes
UPLOAD_DIR=./backend/uploads

# ============================================================================
# EPG Settings
# ============================================================================
EPG_CACHE_TTL=86400          # 24 hours in seconds
EPG_REFRESH_INTERVAL=43200   # 12 hours in seconds
MAX_CHANNELS_PER_SOURCE=10000
MAX_PROGRAMS_PER_CHANNEL=500

# ============================================================================
# Streaming Settings
# ============================================================================
STREAM_TIMEOUT=30000         # 30 seconds in milliseconds
MAX_STREAM_CONNECTIONS=100   # Max concurrent streams per instance

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info              # debug, info, warn, error
LOG_DIR=./backend/logs
LOG_MAX_SIZE=10485760       # 10MB
LOG_MAX_FILES=5

# ============================================================================
# Feature Flags
# ============================================================================
USE_POSTGRES=true           # Set to false to fallback to SQLite during migration
USE_REDIS=true              # Set to false to use in-memory sessions during migration
ENABLE_RATE_LIMITING=true   # Enable/disable rate limiting

# ============================================================================
# Development Tools
# ============================================================================
# Set to true to enable garbage collection exposure
EXPOSE_GC=true

# Maximum old space size for Node.js (in MB)
NODE_MAX_OLD_SPACE_SIZE=4096

# ============================================================================
# Production Deployment
# ============================================================================
# For production, also configure:
# - SSL certificates
# - Load balancer health check endpoints
# - Monitoring (Prometheus, Datadog, etc.)
# - Error tracking (Sentry, etc.)
# - CDN configuration

# Example production settings:
# NODE_ENV=production
# PORT=5001
# POSTGRES_SSL=true
# REDIS_CLUSTER_ENABLED=true
# ENABLE_RATE_LIMITING=true
# LOG_LEVEL=warn
